# Copy this file to ".env" and fill in values on YOUR machine only.
# Never share the .env file or paste its contents anywhere.

# MODE: MOCK (fake test data), HISTORICAL (saved real candles), LIVE (Groww, later)
DATA_MODE=MOCK

# Telegram (create the bot with @BotFather, see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: more people who should also get alerts (comma separated chat ids). They must send /start to the bot first.
TELEGRAM_EXTRA_CHAT_IDS=
# Language of Telegram messages: hi (Hinglish) or en (English). You can also switch with /lang in Telegram.
TELEGRAM_LANG=hi

# Groww Trading API (not purchased yet; leave empty)
GROWW_API_KEY=
GROWW_API_SECRET=
# Optional alternative to the secret (token never expires). Needs: pip install pyotp
GROWW_TOTP_SECRET=

# Safety: order placement is permanently disabled in this project.
ORDERS_ENABLED=false

# standard (strict) or active (up to 5 signals/day, looser rules; not shown better in backtests)
SIGNAL_PROFILE=standard

# true = Telegram sends only trade signals and their stop/target updates
TRADES_ONLY=false

# ---- Option-buying signal engine (paper only). All optional; defaults shown. ----
# Capital the paper account trades with (rupees) and risk limits
# OPT_CAPITAL=10000
# OPT_MAX_RISK_PCT=1.0            # max loss per trade, % of capital (0-5)
# OPT_MAX_DAILY_LOSS_PCT=3.0      # stop for the day after this realised loss
# OPT_MAX_TRADES_PER_DAY=3
# OPT_MAX_CONSECUTIVE_LOSSES=2
# Score thresholds (strategy-quality score, NOT a win probability). Validate with backtests before changing.
# OPT_MIN_SCORE=75                # BUY CALL / BUY PUT only at or above this
# OPT_WAIT_SCORE=60               # between this and MIN_SCORE: WAIT FOR CONFIRMATION
# Contract filters
# OPT_MAX_SPREAD_PCT=3.0
# OPT_MIN_OI_LOTS=50            # open interest in lots
# OPT_MIN_OPTION_VOLUME_LOTS=50
# OPT_MAX_THETA_PCT=25          # theta per day as % of premium
# OPT_COST_BROKERAGE=20         # rupees per order; check your broker
# OPT_COST_SLIPPAGE_PCT=0.3
# OPT_MIN_RR_T1=1.3
# OPT_MIN_RR_T2=2.0
# OPT_MAX_CHASE_ATR=0.6           # skip if price is already this many 5m-ATR beyond the trigger level

# Dashboard on a cloud server (Render): required there, optional on the laptop
# DASHBOARD_PASSWORD=
# DASHBOARD_USER=admin
